<!-- [AI修改] 设置内容可滚动，保存按钮保持可见。 -->
<Window x:Class="CodeXPedal.Windows.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CodeXPedal 设置"
        Width="430"
        Height="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#141B23">
    <!-- [AI修改] 提供悬浮窗、任务栏和启动行为的用户配置入口。 -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="显示设置" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Margin="0,5,0,0" Text="设置只保存在当前 Windows 用户目录。" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,18,0,12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,10,0">
            <!-- [AI修改] 供应方开关同时控制显示和读取，时间选项仅改变展示。 -->
            <CheckBox x:Name="CodexEnabledCheckBox" Content="显示并获取 Codex 额度" Margin="0,0,0,4" />
            <TextBlock Margin="22,0,0,10" Text="取消后不显示 Codex 额度，也不在后台获取。" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" TextWrapping="Wrap" />
            <CheckBox x:Name="ClaudeEnabledCheckBox" Content="显示并获取 Claude 额度" Margin="0,0,0,4" />
            <TextBlock Margin="22,0,0,10" Text="取消后不显示 Claude 额度，也不在后台获取。" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" TextWrapping="Wrap" />
            <TextBlock Text="额度时间显示" Margin="0,0,0,4" />
            <!-- [AI修改] 只给此下拉框应用专用深色样式，收起和展开都保持文字对比度。 -->
            <ComboBox x:Name="QuotaTimeComboBox" Style="{StaticResource QuotaTimeComboBoxStyle}" Margin="0,0,0,4" AutomationProperties.Name="额度时间显示">
                <ComboBoxItem Content="最近获取时间" />
                <ComboBoxItem Content="下次额度重置时间" />
            </ComboBox>
            <TextBlock Margin="0,0,0,16" Text="重置时间由额度来源提供，不是软件下一次查询的时间。" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" TextWrapping="Wrap" />
            <CheckBox x:Name="CompactModeCheckBox" Content="启动后使用紧凑悬浮窗" Margin="0,0,0,16" />
            <CheckBox x:Name="AlwaysOnTopCheckBox" Content="悬浮窗总在最前" Margin="0,0,0,16" />
            <!-- [AI修改] 任务栏遵循同一来源和时间设置。 -->
            <CheckBox x:Name="TaskbarStripCheckBox" Content="在任务栏显示额度和时间" Margin="0,0,0,6" Unchecked="TaskbarStripCheckBox_Unchecked" />
            <TextBlock Margin="22,0,0,16" Text="任务栏栏位默认关闭；资源管理器重启后会自动恢复。" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" TextWrapping="Wrap" />
            <!-- [AI修改] 仅任务栏模式仍允许从任务栏栏位或通知区域临时打开悬浮窗。 -->
            <CheckBox x:Name="TaskbarOnlyModeCheckBox" Content="仅显示任务栏（启动时不显示悬浮窗）" Margin="0,0,0,6" Checked="TaskbarOnlyModeCheckBox_Checked" />
            <TextBlock Margin="22,0,0,16" Text="启用后会自动开启任务栏栏位；单击栏位仍可临时打开悬浮窗。" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" TextWrapping="Wrap" />
            <CheckBox x:Name="StartWithWindowsCheckBox" Content="登录 Windows 后自动启动" Margin="0,0,0,18" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="自动刷新间隔" VerticalAlignment="Center" />
                <TextBox x:Name="RefreshIntervalTextBox" Grid.Column="1" Padding="7,4" />
                <TextBlock Grid.Column="2" Text="秒（15–3600）" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" />
            </Grid>
            <TextBlock x:Name="ValidationText" Margin="150,6,0,0" Foreground="#FFFF8B8B" FontSize="11" />

            <!-- [AI修改] Claude 额度：默认实时读取，状态栏桥接作为备选并写明使用步骤。 -->
            <TextBlock Text="Claude 额度" FontSize="15" FontWeight="SemiBold" Margin="0,14,0,8" />
            <!-- [AI修改] 一键安装并登录 Claude Code（官方脚本 + 浏览器授权）。 -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Button x:Name="ClaudeCliButton" Click="ClaudeCliButton_Click" MinWidth="150" />
                <TextBlock x:Name="ClaudeCliStateText" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="11" TextWrapping="Wrap" MaxWidth="200" Foreground="{StaticResource SecondaryTextBrush}" />
            </StackPanel>
            <CheckBox x:Name="ClaudeLiveQuotaCheckBox" Content="实时读取 Claude 额度（默认，读取本机 Claude 登录令牌）" Margin="0,0,0,6" />
            <TextBlock Margin="22,0,0,10" Text="约每 2 分钟一次（被限流时自动退避）把令牌发送到 Anthropic 官方接口，不保存、不上传到其他地方；令牌过期时需打开一次 Claude Code。" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" TextWrapping="Wrap" />
            <TextBlock Text="备选方式：Claude 状态栏桥接" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBlock Margin="0,0,0,8" Text="不想授权读取令牌，或实时读取失败时使用，需要 Pro/Max 订阅：&#10;1. 点击下方按钮启用桥接，原状态栏会备份，停用后恢复。&#10;2. 在终端运行 claude 并发送一条消息；桌面端可能不会更新额度。&#10;3. 回到本程序等待下次刷新。之后只在发消息时更新，空闲约 3 分钟后数字带 ≈。&#10;如需完全不读取令牌，请同时关闭上方的实时读取。" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <Button x:Name="ClaudeBridgeButton" Click="ClaudeBridgeButton_Click" MinWidth="150" />
                <TextBlock x:Name="ClaudeBridgeStatus" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="11" TextWrapping="Wrap" MaxWidth="200" Foreground="{StaticResource SecondaryTextBrush}" />
            </StackPanel>
        </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Click="CancelButton_Click" Margin="0,0,8,0" MinWidth="76" />
            <Button Content="保存" Click="SaveButton_Click" MinWidth="76" Background="#315C8B" />
        </StackPanel>
    </Grid>
</Window>
