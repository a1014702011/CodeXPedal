<Window x:Class="CodeXPedal.Windows.App.Views.DetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CodeXPedal 详情"
        Width="640"
        Height="570"
        MinWidth="560"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="#141B23">
    <!-- [AI修改] 详情页展示真实数据来源和诊断，并按返回拓扑决定是否显示 5 小时额度。 -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="用量详情" FontSize="22" FontWeight="SemiBold" />
                <!-- [AI修改] 额度来源由真实快照决定，不再固定声称 app-server 已启用。 -->
                <TextBlock Text="{Binding QuotaSourceLabel}" Margin="0,5,0,0" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding RefreshedAt}" FontFamily="Cascadia Mono, Consolas" FontSize="16" VerticalAlignment="Center" />
        </Grid>

        <!-- [AI修改] 折叠 5 小时卡片后自动重新等分，始终保留两项本地 Token 数据，避免双布局遗漏字段。 -->
        <UniformGrid Grid.Row="1" Margin="0,24,0,0" Rows="1">
            <Border Background="{StaticResource CardBrush}" Padding="15" Margin="0,0,8,0"
                    Visibility="{Binding HasFiveHourQuota, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel><TextBlock Text="5 小时剩余" Foreground="{StaticResource SecondaryTextBrush}" /><TextBlock Text="{Binding FiveHourQuota}" FontSize="26" Foreground="{StaticResource AccentBrush}" /></StackPanel>
            </Border>
            <Border Background="{StaticResource CardBrush}" Padding="15" Margin="0,0,8,0">
                <StackPanel><TextBlock Text="7 天剩余" Foreground="{StaticResource SecondaryTextBrush}" /><TextBlock Text="{Binding SevenDayQuota}" FontSize="26" Foreground="{StaticResource AccentBrush}" /></StackPanel>
            </Border>
            <Border Background="{StaticResource CardBrush}" Padding="15" Margin="0,0,8,0">
                <StackPanel><TextBlock Text="今日 Token" Foreground="{StaticResource SecondaryTextBrush}" /><TextBlock Text="{Binding TodayTokens}" FontSize="24" /></StackPanel>
            </Border>
            <Border Background="{StaticResource CardBrush}" Padding="15">
                <StackPanel><TextBlock Text="Claude 今日" Foreground="{StaticResource SecondaryTextBrush}" /><TextBlock Text="{Binding ClaudeTodayTokens}" FontSize="24" /></StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="7 天 Token" Foreground="{StaticResource SecondaryTextBrush}" /><TextBlock Text="{Binding SevenDayTokens}" FontSize="18" /></StackPanel>
            <StackPanel Grid.Column="1"><TextBlock Text="累计 Token" Foreground="{StaticResource SecondaryTextBrush}" /><TextBlock Text="{Binding LifetimeTokens}" FontSize="18" /></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="活跃任务" Foreground="{StaticResource SecondaryTextBrush}" /><TextBlock Text="{Binding ActiveTasks}" FontSize="18" /></StackPanel>
            <StackPanel Grid.Column="3"><TextBlock Text="待处理任务" Foreground="{StaticResource SecondaryTextBrush}" /><TextBlock Text="{Binding PendingTasks}" FontSize="18" /></StackPanel>
        </Grid>

        <GroupBox Grid.Row="3" Header="数据状态" Margin="0,24,0,0" Foreground="{StaticResource PrimaryTextBrush}" BorderBrush="{StaticResource BorderBrush}">
            <!-- [AI修改] 诊断信息仅用于展示，禁止 TextBox 向只读属性回写。 -->
            <TextBox Text="{Binding Diagnostics, Mode=OneWay}"
                     Margin="10"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Background="#0F151C"
                     Foreground="{StaticResource SecondaryTextBrush}"
                     BorderThickness="0" />
        </GroupBox>
        <Button Grid.Row="4" Content="关闭" Click="CloseButton_Click" HorizontalAlignment="Right" Margin="0,18,0,0" MinWidth="80" />
    </Grid>
</Window>
