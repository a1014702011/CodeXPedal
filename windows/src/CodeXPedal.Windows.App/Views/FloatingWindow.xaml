<Window x:Class="CodeXPedal.Windows.App.Views.FloatingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CodeXPedal"
        Width="500"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseDoubleClick="Window_MouseDoubleClick"
        Closing="Window_Closing"
        LocationChanged="Window_LocationChanged">
    <Window.Resources>
        <!-- [AI修改] 单行额度模板：名称标签（可选）+ 5 小时（按返回拓扑）+ 7 天 + 更新时间，Codex/Claude 共用。 -->
        <DataTemplate x:Key="QuotaRowTemplate">
            <Border Background="{StaticResource CardBrush}" Height="66" Margin="0,0,0,6"
                    Visibility="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="62" BorderBrush="#384A5B" BorderThickness="0,0,1,0"
                            Visibility="{Binding ShowLabel, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <UniformGrid Rows="1">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="{Binding HasFiveHourQuota, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="5 小时" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding FiveHourQuota}" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                        <Border BorderBrush="#384A5B" BorderThickness="{Binding SevenDayBorder}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="7 天" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding SevenDayQuota}" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border BorderBrush="#384A5B" BorderThickness="1,0,0,0">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="更新时间" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding RefreshedAt}" FontFamily="Cascadia Mono, Consolas" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </DockPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <!-- [AI修改] 紧凑模式按真实额度拓扑显示 5 小时/7 天额度和精确更新时间。 -->
    <Border Margin="8"
            Padding="14"
            CornerRadius="9"
            Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.45" Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Margin="0,0,0,12"
                  Visibility="{Binding IsFull, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- [AI修改] 使用新品牌图标替代旧字母占位，并保留圆角裁切。 -->
                <Border Width="30" Height="30" CornerRadius="7" ClipToBounds="True">
                    <Image Source="/Resources/CodeXPedal-icon.png" Stretch="UniformToFill" />
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="CodeXPedal" FontSize="14" FontWeight="SemiBold" />
                    <!-- [AI修改] 副标题随已安装的工具变化。 -->
                    <TextBlock Text="{Binding HeaderSubtitle}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
                </StackPanel>
                <Button Grid.Column="2" Content="紧凑" Click="CompactButton_Click" Padding="9,3" FontSize="11" />
            </Grid>

            <!-- [AI修改] Codex 与 Claude 各占一行，按本机安装情况显示；同时存在时左侧加名称标签。 -->
            <StackPanel Grid.Row="1">
                <ContentControl Content="{Binding CodexRow}" ContentTemplate="{StaticResource QuotaRowTemplate}" Focusable="False" />
                <ContentControl Content="{Binding ClaudeRow}" ContentTemplate="{StaticResource QuotaRowTemplate}" Focusable="False" />
            </StackPanel>

            <!-- [AI修改] 本机 Token 统计只属于 Codex，未安装 Codex 时隐藏。 -->
            <Grid Grid.Row="2"
                  Margin="0,4,0,0"
                  Visibility="{Binding ShowCodexTokens, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="今日" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding TodayTokens}" FontSize="14" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <TextBlock Text="7 天 Token" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding SevenDayTokens}" FontSize="14" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <TextBlock Text="累计" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding LifetimeTokens}" FontSize="14" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                    <TextBlock Text="活跃" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding ActiveTasks}" FontSize="14" FontWeight="SemiBold" Foreground="#FF7ED7FF" />
                </StackPanel>
                <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                    <TextBlock Text="待处理" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding PendingTasks}" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFC76A" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="3"
                  Margin="0,12,0,0"
                  Visibility="{Binding IsFull, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- [AI修改] 用通俗文案说明 Token 统计口径，并明确它不代表官方额度或账单。 -->
                <TextBlock Text="{Binding TokenSourceLabel}"
                           ToolTip="仅用于观察本机使用趋势，不代表官方额度或账单。"
                           FontSize="10"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="详情" Click="DetailsButton_Click" Margin="0,0,6,0" FontSize="11" />
                <Button Grid.Column="2" Content="刷新" Click="RefreshButton_Click" FontSize="11" IsEnabled="{Binding IsRefreshing, Converter={StaticResource InverseBooleanConverter}, FallbackValue=True}" />
            </Grid>
        </Grid>
    </Border>
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="立即刷新" Click="RefreshMenuItem_Click" />
            <MenuItem Header="切换紧凑模式" Click="CompactMenuItem_Click" />
            <Separator />
            <MenuItem Header="详情" Click="DetailsMenuItem_Click" />
            <MenuItem Header="设置" Click="SettingsMenuItem_Click" />
            <Separator />
            <MenuItem Header="退出" Click="ExitMenuItem_Click" />
        </ContextMenu>
    </Window.ContextMenu>
</Window>
