<Application x:Class="CodeXPedal.Windows.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:CodeXPedal.Windows.App.Converters"
             ShutdownMode="OnExplicitShutdown">
    <!-- [AI修改] 统一 TrafficMonitor 风格的深色紧凑视觉。 -->
    <Application.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <SolidColorBrush x:Key="PanelBrush" Color="#F2111820" />
        <SolidColorBrush x:Key="CardBrush" Color="#D91B2530" />
        <SolidColorBrush x:Key="BorderBrush" Color="#5D718399" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FFF4F7FA" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#FFA8B4C2" />
        <SolidColorBrush x:Key="AccentBrush" Color="#FF56D6B5" />
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="#273441" />
            <Setter Property="BorderBrush" Value="#506276" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="1" />
            <!-- [AI修改] 系统默认按钮禁用时背景变浅灰，配合全局近白文字会变成白块；改用深色模板，禁用时只降低不透明度。 -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#FF7FA3C7" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.8" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#FF7FA3C7" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- [AI修改] 全局 TextBlock 为近白色，右键菜单和悬停提示若沿用系统浅色背景会变成白底白字；统一改为深色背景。 -->
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="#FF1B2530" />
            <Setter Property="BorderBrush" Value="#FF506276" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <!-- [AI修改] 系统模板左侧图标栏是写死的浅色，会留下白色竖条；改用只有深色边框和菜单项的简洁模板。 -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" Padding="2" SnapsToDevicePixels="True">
                            <ItemsPresenter Grid.IsSharedSizeScope="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#FF1B2530" />
            <Setter Property="BorderBrush" Value="#FF506276" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        </Style>
    </Application.Resources>
</Application>
